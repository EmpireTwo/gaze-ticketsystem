{
    "name": "empire2/gaze-ticketsystem",
    "description": "Standalone Laravel ticket-system. Livewire-driven kanban/list board, AI analysis, follow-ups, notifications, and an optional ghostwriter integration via source resolvers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "tickets",
        "support",
        "helpdesk",
        "kanban",
        "ai",
        "gaze"
    ],
    "homepage": "https://github.com/EmpireTwo/gaze-ticketsystem",
    "support": {
        "issues": "https://github.com/EmpireTwo/gaze-ticketsystem/issues",
        "source": "https://github.com/EmpireTwo/gaze-ticketsystem"
    },
    "authors": [
        {
            "name": "Lord Eagle",
            "email": "hello@lordeagle.ie",
            "homepage": "https://github.com/lord-eagle"
        },
        {
            "name": "The gaze-ticketsystem Contributors",
            "homepage": "https://github.com/EmpireTwo/gaze-ticketsystem/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/support": "^12.0",
        "laravel/ai": "^0.4.3",
        "livewire/livewire": "^4.0",
        "empiretwo/gaze-laravel": "^0.6",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "empire2/gaze-ghostwriter": "Installs the ghostwriter package so support drafts can be turned into tickets via the source_resolvers config."
    },
    "autoload": {
        "psr-4": {
            "Empire2\\GazeTicketsystem\\": "src/",
            "Empire2\\GazeTicketsystem\\Database\\Factories\\": "database/factories/",
            "Empire2\\GazeTicketsystem\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Empire2\\GazeTicketsystem\\Tests\\": "tests/"
        },
        "files": [
            "tests/Feature/ticketing-helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Empire2\\GazeTicketsystem\\GazeTicketsystemServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "empiretwo/gaze-laravel": true,
            "pestphp/pest-plugin": true
        }
    }
}
