includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: 5
    paths:
        - src
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Host class referenced via config defaults (config('gaze-ticketsystem.user_model'))
        # — exists in the host app at runtime, not in the package's own tree.
        - '#Class App\\Models\\User not found#'
        # Trait designed for host User model, not package internals.
        -
            message: '#Trait Empire2\\GazeTicketsystem\\Concerns\\IsTicketAdmin is used zero times#'
            path: src/Concerns/IsTicketAdmin.php
        - '#@method for method Empire2\\GazeTicketsystem\\Concerns\\IsTicketAdmin::admins\(\)#'
        # Livewire admin components return namespaced views by string.
        - '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
        # Livewire 3+ computed properties (#[Computed]) appear dynamically;
        # PHPStan sees them as undefined. Suppress for admin board components.
        -
            message: '#Access to an undefined property Empire2\\GazeTicketsystem\\Livewire\\Admin\\.+::\$(admins|statuses)#'
            path: src/Livewire/Admin/
        # Eloquent generic factory annotations are noise for package-level models.
        - '#uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types: TFactory#'
        - '#newFactory\(\) return type with generic class Illuminate\\Database\\Eloquent\\Factories\\Factory does not specify its types: TModel#'
        # Host model resolution at runtime — User/Customer ids accessed via config models.
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id#'
            path: src/Livewire/Admin/
        # Host User scope `admins()` resolved by host model at runtime.
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder<Illuminate\\Database\\Eloquent\\Model>::admins\(\)#'
            path: src/Support/AdminResolver.php
        # Customer model may use Spatie SoftDeletes -> withTrashed(); resolved at runtime.
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder<Illuminate\\Database\\Eloquent\\Model>::withTrashed\(\)#'
            path: src/Support/CustomerLookup.php
        -
            message: '#Unable to resolve the template type TWhenReturnType in call to method Illuminate\\Database\\Eloquent\\Builder<Illuminate\\Database\\Eloquent\\Model>::when\(\)#'
            path: src/Support/CustomerLookup.php
        # Cosmetic: nullsafe on guaranteed value.
        -
            message: '#Using nullsafe property access "\?->name" on left side of \?\? is unnecessary#'
            path: src/Livewire/Admin/TicketBoard.php
        # PHPDoc class-string<Model> vs static — runtime-resolved customer model.
        -
            message: '#PHPDoc tag @var with type class-string<Illuminate\\Database\\Eloquent\\Model> is not subtype of native type class-string<static\(Empire2\\GazeTicketsystem\\Models\\Ticket\)>#'
            path: src/Models/Ticket.php
